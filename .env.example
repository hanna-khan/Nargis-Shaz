NEXT_PUBLIC_SITE_URL=https://www.nargisandshaz.com
# DATA_SOURCE=supabase   # Phase 2
#   ^ Both lines above are kept from the original file. DATA_SOURCE is no longer read: the
#     application now uses MySQL through DATABASE_URL (see docs/DEPLOYMENT_GUIDE.md).

# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env (local) or enter in Hostinger → Web app → Environment variables.
# Never commit real values. Only NEXT_PUBLIC_* values reach the browser — never put a secret in one.
# ─────────────────────────────────────────────────────────────────────────────

# Core
APP_ENV=production                 # production | staging | development  (test gateway is impossible in production)
APP_URL=https://www.nargisandshaz.com   # absolute origin used in emails, payment return URLs and CSRF checks
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_POOL_SIZE=10
CRON_SECRET=                       # long random string; sent as "Authorization: Bearer …" to /api/cron/maintenance

# First Studio owner (used once by `npm run db:seed` if no owner exists; remove afterwards)
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=               # 12+ chars, not containing the email/name
SEED_OWNER_NAME=Studio Owner

# Email — Resend (https://resend.com). Without a key, emails are logged as "skipped", never "sent".
RESEND_API_KEY=
EMAIL_FROM="Nargis & Shaz <orders@nargisandshaz.com>"   # domain must be verified in Resend
EMAIL_REPLY_TO=care@nargisandshaz.com
EMAIL_LOG_TO_CONSOLE=0             # 1 = also print rendered emails to the server log (development only)

# Payments — Safepay (Pakistan). Implemented from public docs; verify in sandbox before enabling.
SAFEPAY_ENV=sandbox                # sandbox | production
SAFEPAY_API_KEY=                   # public "client" key
SAFEPAY_SECRET_KEY=                # merchant secret — server only
SAFEPAY_WEBHOOK_SECRET=            # from Safepay dashboard → Developer → Webhooks

# Payments — Stripe (only if a UK/EU legal entity is approved by Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Payments — local test gateway (ignored when APP_ENV=production)
PAYMENTS_TEST_PROVIDER=0
TEST_PAYMENTS_SECRET=

# Media — Cloudflare R2 (S3-compatible). MEDIA_DRIVER=local writes to public/uploads (development only).
MEDIA_DRIVER=r2                    # r2 | local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=https://media.nargisandshaz.com   # public bucket domain, no trailing slash

# Bot protection — Cloudflare Turnstile (optional; forms work without it)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Monitoring — NOT yet wired: setting this only marks the status in Studio → Settings. Errors go to server logs.
SENTRY_DSN=

# Build / ops
NEXT_OUTPUT_STANDALONE=0           # 1 = emit .next/standalone (for VPS/Docker; not needed on Hostinger web apps)
RATE_LIMIT_DISABLED=0              # never set to 1 in production
